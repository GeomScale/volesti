@node Examples
@chapter Examples

@subsection Computing the Volume of a Cube

@example
@group
% Generate a 3-dimensional cube
P = GenCube(3);
% Compute its volume
vol = volume(P);
printf("Volume of 3D cube: %f\n", vol);
@end group
@end example

@subsection Sampling from a Polytope

@example
@group
% Generate a 3-dimensional cube
P = GenCube(3);
% Sample 100 points uniformly
points = sample_points(P, 100);
% Plot first two dimensions
plot(points(1,:), points(2,:), 'o');
@end group
@end example

